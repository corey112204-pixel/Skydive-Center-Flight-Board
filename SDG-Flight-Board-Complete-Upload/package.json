{
  "name": "sdg-flight-operations",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "concurrently -k \"node --watch server.mjs\" \"vite\"",
    "build": "tsc -b && vite build",
    "start": "node web-server.mjs",
    "test": "vitest run src",
    "test:api": "node --test server.test.mjs",
    "test:web": "node --test web-server.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "date-fns": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "typescript": "latest",
    "vite": "latest",
    "web-push": "3.6.7",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "vitest": "latest"
  }
}
